# RescueAI Environment Configuration
# Copy this file to .env.local in the web/ directory to connect to a live Supabase project.
# If these variables are not provided, RescueAI will automatically run in full Demonstration Mode
# with realistic offline seed data and local browser persistence.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Base URL for QR Code Profile links (defaults to current window origin)
NEXT_PUBLIC_APP_URL=https://rescueai.org
